{
  "name": "pi-lark-gateway",
  "version": "1.0.0-rc.1",
  "description": "Self-hosted Feishu gateway for the Pi coding agent SDK",
  "license": "UNLICENSED",
  "repository": { "type": "git", "url": "git+https://github.com/SokuRitszZ/pi-lark-gateway.git" },
  "bin": { "pi-lark-gateway": "bin/pi-lark-gateway.js" },
  "files": ["bin/", "src/", "scripts/doctor.js", "scripts/backup.js", "scripts/restart.js", "docs/", "deploy/", "CHANGELOG.md", "SECURITY.md"],
  "publishConfig": { "registry": "https://registry.npmjs.org/", "access": "public" },
  "type": "module",
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "setup": "node --use-env-proxy src/onboarding/index.js setup",
    "start": "node bin/pi-lark-gateway.js start",
    "restart": "node scripts/restart.js",
    "test": "node --test",
    "check": "node scripts/check.js",
    "verify": "npm test && npm run check && npm run setup -- --help",
    "release:check": "npm run verify && npm audit --omit=dev --audit-level=high",
    "release:pack": "npm run release:check && node scripts/release.js",
    "smoke:clean": "node scripts/smoke-clean.js",
    "smoke:npm": "node scripts/smoke-npm.js",
    "release:npm": "npm run release:check && node scripts/npm-release.js",
    "prepublishOnly": "node scripts/npm-publish-guard.js",
    "doctor": "node scripts/doctor.js",
    "backup": "node scripts/backup.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@larksuiteoapi/node-sdk": "1.74.0",
    "qrcode": "1.5.4",
    "undici": "8.10.2"
  }
}
